// مخطّط قاعدة البيانات — اختياري.
// الموقع يعمل كاملاً بدونه؛ وتُستعمل القاعدة لحفظ الحسابات والتقدّم
// وتحرير المحتوى من لوحة الإدارة.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ------------------------- الحسابات (NextAuth) ------------------------ */

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  progress  Progress[]
  favorites Favorite[]
  searches  SearchLog[]
}

enum Role {
  USER
  EDITOR
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/* ---------------------------- محتوى المنصّة --------------------------- */

model Meter {
  id          String  @id
  slug        String  @unique
  name        String
  family      String
  form        String
  key         String
  formula     String
  description String
  tone        String
  frequency   Int     @default(5)
  published   Boolean @default(true)

  examples Example[]
  verses   Verse[]
}

model Foot {
  id            String  @id
  slug          String  @unique
  name          String
  plain         String
  pattern       String
  description   String
  pronunciation String
  published     Boolean @default(true)

  words Word[]
}

model Word {
  id        String  @id @default(cuid())
  word      String  @unique
  plain     String
  waqf      String
  wasl      String
  tanween   String
  segments  String[]
  source    String
  morph     String?
  root      String?
  approved  Boolean @default(true)
  footId    String?

  foot Foot? @relation(fields: [footId], references: [id])

  @@index([waqf])
  @@index([wasl])
  @@index([tanween])
  @@index([plain])
}

model Verse {
  id      String  @id @default(cuid())
  sadr    String
  ajz     String
  poet    String
  theme   String?
  meterId String?

  meter Meter? @relation(fields: [meterId], references: [id])
}

model Example {
  id      String @id @default(cuid())
  text    String
  note    String?
  meterId String

  meter Meter @relation(fields: [meterId], references: [id], onDelete: Cascade)
}

model Lesson {
  id        String  @id @default(cuid())
  slug      String  @unique
  title     String
  level     String
  order     Int
  summary   String
  minutes   Int     @default(5)
  body      Json
  quiz      Json
  published Boolean @default(true)
}

model Exercise {
  id          String @id @default(cuid())
  kind        String
  level       String
  prompt      String
  context     String?
  payload     Json
  explanation String
  points      Int    @default(10)
}

/* --------------------------- بيانات المستخدم -------------------------- */

model Progress {
  id     String   @id @default(cuid())
  userId String
  level  String
  right  Int      @default(0)
  wrong  Int      @default(0)
  points Int      @default(0)
  day    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, level, day])
}

model Favorite {
  id       String   @id @default(cuid())
  userId   String
  kind     String
  refId    String
  title    String
  subtitle String?
  at       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, refId])
}

model SearchLog {
  id     String   @id @default(cuid())
  userId String
  text   String
  meter  String?
  ok     Boolean  @default(false)
  at     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
}
