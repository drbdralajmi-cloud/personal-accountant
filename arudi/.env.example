# كل هذه المتغيّرات اختيارية: الموقع يعمل كاملاً بدونها.
# المحتوى يُبنى من ملفات المشروع، والمفضّلة والتقدّم يُحفظان في المتصفّح.

# ── عنوان الموقع (لخريطة الموقع ووسوم المشاركة) ──
NEXT_PUBLIC_SITE_URL="https://example.com"

# ── قاعدة البيانات (لحفظ الحسابات والتقدّم على الخادم) ──
# بعد ضبطها: npm run db:push && npm run db:seed
DATABASE_URL="postgresql://user:password@localhost:5432/arudi?schema=public"

# ── NextAuth ──
NEXTAUTH_URL="http://localhost:4600"
NEXTAUTH_SECRET="بدّل هذا بسرٍّ عشوائي: openssl rand -base64 32"

# ── المديرون: بُرد مفصولة بفاصلة، لهم وحدهم التحرير في لوحة الإدارة ──
ADMIN_EMAILS="you@example.com"

# ── جهات الدخول: فعّل ما تريد منها ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="العروض <no-reply@example.com>"
